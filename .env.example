# Токен від @BotFather
BOT_TOKEN=123456:ABC...

# Публічне ім'я бота без @
BOT_USERNAME=your_bot_name

# Секрет для видачі квитків на сайті (придумайте довгий рядок)
ADMIN_SECRET=change-me-now

# Порт. На Railway/Render задається сам.
PORT=3000

# Публічна адреса сайту, без слеша в кінці. Потрібна для кнопок і вебхука.
# Приклад: https://your-app.up.railway.app
PUBLIC_URL=

# Якщо заповнено — бот працює через webhook. Інакше — polling (для першого запуску ок).
# WEBHOOK_URL=https://your-app.up.railway.app/telegram-webhook
